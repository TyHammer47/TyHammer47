generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())

  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String?

  ticketsCreated Ticket[]        @relation("TicketCreatedBy")
  comments       TicketComment[]
  resetTokens    PasswordResetToken[]

  @@index([companyId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  domain      String?
  contactName String?
  contactEmail String?
  contactPhone String?
  notes       String?
  createdAt   DateTime @default(now())

  users    User[]
  tickets  Ticket[]
  tasks    Task[]
  projects Project[]
}

model Project {
  id              String        @id @default(cuid())
  name            String
  description     String?
  status          ProjectStatus @default(PLANNING)
  progressPercent Int           @default(0)
  estimatedHours  Float?
  startDate       DateTime?
  targetDate      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  timeEntries TimeEntry[]

  @@index([companyId])
}

model TimeEntry {
  id        String   @id @default(cuid())
  hours     Float
  note      String?
  workDate  DateTime @default(now())
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId])
}

model Ticket {
  id          String         @id @default(cuid())
  number      Int            @default(autoincrement()) @unique
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  createdBy   User   @relation("TicketCreatedBy", fields: [createdById], references: [id])
  createdById String

  comments TicketComment[]

  @@index([companyId])
  @@index([status])
}

model TicketComment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  @@index([ticketId])
}

model Task {
  id        String    @id @default(cuid())
  title     String
  done      Boolean   @default(false)
  dueDate   DateTime?
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@index([companyId])
}
