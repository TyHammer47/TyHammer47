DATABASE_URL="postgresql://user:password@localhost:5432/tickets_dev?schema=public"

# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-string"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Used by `npm run db:seed` to create/update the first engineer (admin) login.
ADMIN_EMAIL="you@yourcompany.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Your Name"

# Optional: sends real "forgot password" emails via Resend (https://resend.com).
# Without this set, reset links are logged to the server console instead of emailed —
# fine for local development, not for production.
RESEND_API_KEY=""
EMAIL_FROM="Hammer IT Solution <onboarding@resend.dev>"
